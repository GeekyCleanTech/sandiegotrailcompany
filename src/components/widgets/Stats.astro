---
import type { Stats as Props } from '~/types';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  stats = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-center">
    {
      stats &&
        stats.map(({ amount, title, icon }) => {
          // Clean brackets if present for sleek badge/value display
          const cleanAmount = typeof amount === 'string' ? amount.replace(/^\[|\]$/g, '') : amount;
          return (
            <div class="flex flex-col items-center justify-center p-6 sm:p-8 rounded-xl bg-white dark:bg-slate-900 border border-[#3b2314]/10 shadow-sm hover:shadow-md transition-all intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade intersect-quarter">
              {icon && (
                <div class="w-12 h-12 mb-4 rounded-full bg-[#7C8B5A]/15 flex items-center justify-center text-[#7C8B5A]">
                  <Icon name={icon} class="w-6 h-6" />
                </div>
              )}
              {cleanAmount && (
                <div class="font-serif text-[#3b2314] dark:text-white text-2xl sm:text-3xl font-normal leading-tight mb-2">
                  {cleanAmount}
                </div>
              )}
              {title && <div class="text-xs font-semibold uppercase tracking-[0.15em] text-[#c49a3c]">{title}</div>}
            </div>
          );
        })
    }
  </div>
</WidgetWrapper>
