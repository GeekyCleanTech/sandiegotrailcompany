---
import { ANALYTICS } from 'astrowind:config';

const id = ANALYTICS?.vendors?.googleTagManager?.id ? String(ANALYTICS.vendors.googleTagManager.id) : '';
---

<script is:inline id="gtm-init" data-id={id}>
  if (document.getElementById('gtm-init').dataset.id) {
    (function (w, d, s, l, i) {
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      const f = d.getElementsByTagName(s)[0];
      const j = d.createElement(s);
      const dl = l !== 'dataLayer' ? '&l=' + l : '';
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
      f.parentNode.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', document.getElementById('gtm-init').dataset.id);
  }
</script>
