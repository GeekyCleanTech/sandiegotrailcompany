---
import { Icon } from 'astro-icon/components';

const BOOK_URL = 'https://fareharbor.com/embeds/book/powaytrailcompany/items/';

interface NavLink {
  label: string;
  href: string;
  children?: { label: string; href: string }[];
}

const links: NavLink[] = [
  { label: 'Home', href: '/' },
  {
    label: 'Ride & Learn',
    href: '/ride-and-learn/',
    children: [
      { label: 'Horse Boarding', href: '/ride-and-learn/horse-boarding/' },
      { label: 'Train With Us', href: '/ride-and-learn/train-with-us/' },
    ],
  },
  { label: 'Stay & Celebrate', href: '/stay-and-celebrate/' },
  { label: 'Give & Support', href: '/give-and-support/' },
  { label: 'About', href: '/about/' },
  { label: 'Blog', href: '/blog/' },
  {
    label: 'Events',
    href: '/events/matcha-on-ice/',
    children: [{ label: 'Matcha on Ice', href: '/events/matcha-on-ice/' }],
  },
  { label: 'Contact', href: '/contact/' },
];

const raw = Astro.url.pathname;
const path = raw !== '/' && raw.endsWith('/') ? raw.slice(0, -1) : raw;
const stripSlash = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const isActive = (href: string) => {
  const h = stripSlash(href);
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};
---

<nav
  id="site-nav"
  role="navigation"
  aria-label="Main navigation"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 shadow-md"
  style="background-color: #3b2314;"
>
  <div class="max-w-400 mx-auto px-6 lg:px-12 py-4 flex items-center justify-between">
    <a
      href="/"
      aria-label="San Diego Trail Company – Home"
      style="font-family:'Cormorant Garamond',serif;font-size:26px;font-weight:400;color:#c49a3c;text-decoration:none;line-height:1;"
    >
      San Diego Trail Company
    </a>

    <!-- Desktop nav -->
    <ul class="hidden lg:flex items-center gap-6 xl:gap-8 list-none m-0 p-0" role="list">
      {
        links.map((link) => (
          <li class="relative group">
            <a
              href={link.href}
              class={`transition-colors rounded-sm flex items-center gap-1 ${isActive(link.href) ? 'text-[#c49a3c]' : 'text-white hover:text-[#c49a3c]'}`}
              style="font-size:13px;letter-spacing:0.12em;text-transform:uppercase;text-decoration:none;"
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
              {link.children && <Icon name="tabler:chevron-down" class="w-3.5 h-3.5" />}
            </a>
            {link.children && (
              <ul class="absolute left-0 top-full pt-2 hidden group-hover:block list-none m-0 p-0 z-50">
                <li class="bg-[#3b2314] border border-[#c49a3c]/20 shadow-xl rounded-md py-2 px-4 min-w-45">
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class={`block py-1.5 transition-colors rounded-sm whitespace-nowrap ${isActive(child.href) ? 'text-[#c49a3c]' : 'text-white/90 hover:text-[#c49a3c]'}`}
                      style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
                    >
                      {child.label}
                    </a>
                  ))}
                </li>
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    <div class="hidden lg:block">
      <a
        href={BOOK_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 rounded-full transition-all hover:brightness-110 inline-flex items-center"
        style="background-color:#c49a3c;color:#3b2314;font-size:12px;font-weight:500;height:44px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
      >
        Book Your Ride
      </a>
    </div>

    <!-- Mobile controls -->
    <div class="lg:hidden flex items-center gap-4">
      <a
        href={BOOK_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 rounded-full inline-flex items-center"
        style="background-color:#c49a3c;color:#3b2314;font-size:11px;font-weight:500;height:40px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
      >
        Book
      </a>
      <button
        id="nav-toggle"
        type="button"
        class="text-white rounded-sm p-1 inline-flex items-center justify-center"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
      >
        <span id="nav-icon-open"><Icon name="tabler:menu-2" class="w-6 h-6" /></span>
        <span id="nav-icon-close" class="hidden"><Icon name="tabler:x" class="w-6 h-6" /></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" hidden class="lg:hidden px-6 py-6 flex flex-col gap-1" style="background-color:#3b2314;">
    <ul role="list" class="list-none m-0 p-0 flex flex-col gap-1">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class={`block py-3 border-b border-white/10 transition-colors rounded-sm ${isActive(link.href) ? 'text-[#c49a3c]' : 'text-white hover:text-[#c49a3c]'}`}
              style="font-size:13px;letter-spacing:0.12em;text-transform:uppercase;text-decoration:none;"
            >
              {link.label}
            </a>
            {link.children && (
              <ul role="list" class="list-none m-0 pl-4 py-1 flex flex-col gap-1 border-b border-white/10">
                {link.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class={`block py-2 transition-colors rounded-sm ${isActive(child.href) ? 'text-[#c49a3c]' : 'text-white/80 hover:text-[#c49a3c]'}`}
                      style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
                    >
                      ↳ {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script is:inline>
  (function () {
    const nav = document.getElementById('site-nav');
    function onScroll() {
      if (!nav) return;
      if (window.scrollY > 20) {
        nav.style.backgroundColor = '#3b2314';
        nav.classList.add('shadow-lg', 'border-b', 'border-[#c49a3c]/20');
      } else {
        nav.style.backgroundColor = '#3b2314';
        nav.classList.remove('shadow-lg', 'border-b', 'border-[#c49a3c]/20');
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('nav-icon-open');
    const iconClose = document.getElementById('nav-icon-close');

    function closeMenu() {
      if (!menu || !toggle) return;
      menu.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation menu');
      if (iconOpen) iconOpen.classList.remove('hidden');
      if (iconClose) iconClose.classList.add('hidden');
    }

    if (toggle && menu) {
      toggle.addEventListener('click', function () {
        if (menu.hasAttribute('hidden')) {
          menu.removeAttribute('hidden');
          toggle.setAttribute('aria-expanded', 'true');
          toggle.setAttribute('aria-label', 'Close navigation menu');
          if (iconOpen) iconOpen.classList.add('hidden');
          if (iconClose) iconClose.classList.remove('hidden');
        } else {
          closeMenu();
        }
      });
      menu.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', closeMenu);
      });
    }
  })();
</script>
