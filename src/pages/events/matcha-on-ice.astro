---
import SiteLayout from '~/layouts/SiteLayout.astro';
import { Icon } from 'astro-icon/components';

const BOOKING_URL = 'https://fareharbor.com/embeds/book/powaytrailcompany/items/';

const metadata = {
  title: 'Matcha on Ice × Rustic Ranch Horseback Rides | Poway, CA',
  description:
    'Meet us in the saddle on October 10, 2026. Enjoy a 15-minute horseback ride at Rustic Ranch following your Matcha on Ice pilates class in Poway, CA.',
  robots: {
    index: false,
    follow: false,
  },
};

const benefits = [
  {
    title: '$25 Horseback Ride',
    description:
      'Enjoy a 15-minute guided horseback ride across Rustic Ranch pastures for just $25. The perfect post-pilates experience.',
    image: '/images/events/matcha-on-ice/poway_trail_ride_1786669231098.png',
    alt: 'A group of happy women enjoying a scenic horse trail ride through the rolling, rugged hills of Poway',
    icon: 'tabler:horseshoe',
  },
  {
    title: 'Ranch & Horse Connection',
    description:
      'Experience authentic ranch life up close. Meet our gentle horses, take candid photos, and soak in backcountry Poway views.',
    image: '/images/events/matcha-on-ice/candid_ranch_horse_1786647063716.png',
    alt: 'Candid photo of a woman connecting with a gentle ranch horse',
    icon: 'tabler:heart',
  },
  {
    title: 'Seamless Itinerary',
    description:
      "Reserve your ride time slot in advance and we'll have your horse ready for your scheduled window after your pilates class and iced matcha.",
    image: '/images/events/matcha-on-ice/candid_iced_matcha_1786647051966.png',
    alt: 'Candid photo of a glass of artisanal iced matcha tea served over ice on a warm, sunlit ranch deck',
    icon: 'tabler:clock-hour-4',
  },
];

const faqs = [
  {
    question: 'Is horseback riding experience necessary?',
    answer:
      'Not at all! No prior horseback riding experience is required. Our patient trail wranglers guide you every step of the way, making it safe, fun, and relaxing for first-time riders.',
  },
  {
    question: 'What should I wear for pilates and riding?',
    answer:
      'We recommend wearing comfortable athletic wear for pilates. For safety while riding, please bring or wear sturdy closed-toe shoes (sneakers or boots). Long pants or leggings are recommended for riding comfort.',
  },
  {
    question: 'Where is the venue located?',
    answer:
      'The event takes place at San Diego Trail Company / Poway Equestrian Center Ranch: 14875 Mina De Oro Rd, Poway, CA 92064. Free parking is available on site.',
  },
  {
    question: 'How do I schedule my specific ride time?',
    answer:
      'Click any "Reserve Your Ride" or "Select Time" button on this page to open our online booking system. You can choose your preferred scheduled 15-minute window after your pilates class.',
  },
];
---

<SiteLayout metadata={metadata}>
  <!-- CUSTOM STYLING TOKENS FOR DUSTY PINK COOL-GIRL COWGIRL AESTHETIC -->
  <style>
    .bg-dusty-pink-subtle {
      background-color: #fcf4f4;
    }
    .bg-dusty-pink-pill {
      background-color: #f3dfdf;
    }
    .border-dusty-pink {
      border-color: #d8a4a6;
    }
    .text-dusty-pink {
      color: #b87b7e;
    }
    .btn-dusty-pink {
      background-color: #c48b8e;
      color: #ffffff;
      transition: all 0.2s ease-in-out;
    }
    .btn-dusty-pink:hover {
      background-color: #b3787b;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(196, 139, 142, 0.35);
    }
    .badge-pink {
      background-color: #f5e4e5;
      color: #9c5c60;
      border: 1px solid #e5c3c5;
    }
  </style>

  <main id="main-content" class="bg-[#faf7f2] text-[#2c2c2c]">
    <!-- 1. PARTNER LOGO BAR -->
    <div class="border-b border-[#3b2314]/10 bg-[#3b2314] text-white py-4 px-6">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span class="text-xs uppercase tracking-[0.2em] text-[#c49a3c] font-medium">Official Event Pop-Up</span>
          <span class="text-white/30">•</span>
          <span class="text-xs tracking-wider text-white/80">Matcha on Ice × Rustic Ranch Events</span>
        </div>
        <div class="flex items-center gap-6">
          <!-- Matcha on Ice Badge Container -->
          <div class="px-3 py-1 rounded-full bg-[#f5e4e5]/15 border border-[#e5c3c5]/30 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#e5c3c5]"></span>
            <span class="text-xs font-semibold uppercase tracking-widest text-[#f5e4e5]">Matcha on Ice</span>
          </div>
          <!-- Rustic Ranch Badge Container -->
          <div class="px-3 py-1 rounded-full bg-[#c49a3c]/15 border border-[#c49a3c]/30 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#c49a3c]"></span>
            <span class="text-xs font-semibold uppercase tracking-widest text-[#c49a3c]">Rustic Ranch Events</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. HERO SECTION -->
    <section class="relative pt-12 pb-20 lg:pt-16 lg:pb-28 px-6 overflow-hidden">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 items-center">
        <!-- Left Text Column -->
        <div class="lg:col-span-7 space-y-6">
          <div
            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full badge-pink text-xs font-semibold tracking-wider uppercase"
          >
            <Icon name="tabler:sparkles" class="w-4 h-4 text-[#9c5c60]" />
            An Exclusive Matcha On Ice Add-On
          </div>

          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-serif text-[#3b2314] leading-[1.1] font-normal tracking-tight"
          >
            Matcha on Ice <span class="text-[#c48b8e]">×</span> Rustic Ranch Horseback Rides
          </h1>

          <p class="text-2xl sm:text-3xl font-serif italic text-[#c48b8e]">Meet us in the saddle.</p>

          <p class="text-lg text-[#2c2c2c]/85 leading-relaxed max-w-2xl">
            Elevate your event day with a 15-minute post-pilates horseback ride across our golden Poway pastures. Sip
            ceremonial iced matcha, ground yourself on the ranch deck, and step right into the saddle.
          </p>

          <!-- Key Details Callout Card -->
          <div
            class="p-5 rounded-2xl bg-white border border-dusty-pink/40 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4 max-w-xl"
          >
            <div class="space-y-1">
              <div class="flex items-center gap-2 text-xs font-semibold tracking-wider uppercase text-[#c49a3c]">
                <Icon name="tabler:calendar" class="w-4 h-4" />
                October 10, 2026
              </div>
              <div class="flex items-center gap-2 text-sm text-[#2c2c2c]/80">
                <Icon name="tabler:map-pin" class="w-4 h-4 text-[#c48b8e]" />
                14875 Mina De Oro Rd, Poway, CA 92064
              </div>
            </div>
            <div
              class="text-left sm:text-right border-t sm:border-t-0 sm:border-l border-black/10 pt-3 sm:pt-0 sm:pl-4"
            >
              <span class="block text-2xl font-serif font-bold text-[#3b2314]">$25</span>
              <span class="block text-xs uppercase tracking-wider text-[#9c5c60] font-semibold"
                >Horseback Ride Add-On</span
              >
            </div>
          </div>

          <!-- CTAs -->
          <div class="pt-2 flex flex-col sm:flex-row gap-4">
            <a
              href={BOOKING_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="px-8 py-4 rounded-full btn-dusty-pink font-medium text-center text-sm uppercase tracking-widest inline-flex items-center justify-center gap-2 shadow-lg"
            >
              <Icon name="tabler:ticket" class="w-5 h-5" />
              Reserve Your Ride
            </a>
            <a
              href="#overview"
              class="px-8 py-4 rounded-full bg-white border border-[#3b2314]/20 hover:border-[#3b2314]/50 text-[#3b2314] font-medium text-center text-sm uppercase tracking-widest inline-flex items-center justify-center gap-2 transition-all"
            >
              Event Details
            </a>
          </div>
        </div>

        <!-- Right Image Column -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <!-- Decorative Backdrop Frame -->
            <div
              class="absolute -inset-4 rounded-3xl bg-linear-to-tr from-[#f3dfdf] via-[#faf7f2] to-[#e8c8ca] transform rotate-2 -z-10 border border-dusty-pink/30"
            >
            </div>
            <img
              src="/images/events/matcha-on-ice/hero_socal_ranch_1786647020891.png"
              alt="Warm, sunlit Southern California ranch scene with golden pastures"
              class="w-full h-115 object-cover rounded-2xl shadow-xl border-2 border-white"
              loading="eager"
            />
            <!-- Badge Overlay -->
            <div
              class="absolute bottom-6 left-6 right-6 bg-white/95 backdrop-blur-md p-4 rounded-xl border border-dusty-pink/30 shadow-lg flex items-center justify-between"
            >
              <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-[#9c5c60]"
                  >Poway Equestrian Center</span
                >
                <span class="block text-sm font-serif font-semibold text-[#3b2314]">Rustic Ranch Horseback Rides</span>
              </div>
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-[#f5e4e5] text-[#9c5c60]">$25 Add-On</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. PARTNER / SPONSOR SECTION -->
    <section class="py-12 bg-white border-y border-[#3b2314]/10">
      <div class="max-w-7xl mx-auto px-6 text-center">
        <p class="text-xs uppercase tracking-[0.25em] text-[#9c5c60] font-semibold mb-6">In Proud Collaboration With</p>
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-16">
          <!-- Partner Badge 1: Matcha on Ice -->
          <div
            class="flex items-center gap-4 px-6 py-4 rounded-2xl bg-dusty-pink-subtle border border-dusty-pink/40 shadow-sm"
          >
            <div class="w-12 h-12 rounded-full bg-[#f5e4e5] flex items-center justify-center text-[#9c5c60]">
              <Icon name="tabler:cup" class="w-6 h-6" />
            </div>
            <div class="text-left">
              <span class="block text-lg font-serif font-bold text-[#3b2314]">Matcha on Ice</span>
              <span class="block text-xs tracking-wider text-[#9c5c60] uppercase font-medium"
                >Movement & Iced Matcha Bar</span
              >
            </div>
          </div>

          <!-- Divider -->
          <div class="hidden sm:block text-2xl font-serif text-[#c48b8e] font-light">×</div>

          <!-- Partner Badge 2: Rustic Ranch Events -->
          <div class="flex items-center gap-4 px-6 py-4 rounded-2xl bg-[#fcf9f2] border border-[#c49a3c]/30 shadow-sm">
            <div class="w-12 h-12 rounded-full bg-[#c49a3c]/15 flex items-center justify-center text-[#3b2314]">
              <Icon name="tabler:horseshoe" class="w-6 h-6 text-[#c49a3c]" />
            </div>
            <div class="text-left">
              <span class="block text-lg font-serif font-bold text-[#3b2314]">Rustic Ranch Events</span>
              <span class="block text-xs tracking-wider text-[#c49a3c] uppercase font-medium"
                >San Diego Trail Company</span
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. EVENT OVERVIEW & VALUE PROPOSITION -->
    <section id="overview" class="py-20 px-6">
      <div class="max-w-7xl mx-auto space-y-16">
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <span class="text-xs uppercase tracking-[0.2em] font-semibold text-[#c48b8e] block">
            Exclusive Event Add-On
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-[#3b2314] font-normal">
            From the Pilates Mat to the Saddle
          </h2>
          <p class="text-lg text-[#2c2c2c]/85 leading-relaxed">
            We’re opening our pastures for an exclusive add-on experience for Matcha on Ice guests. Following your
            outdoor pilates movement class and iced matcha, hop into the saddle for a 15-minute guided horseback ride
            across Rustic Ranch.
          </p>
          <div
            class="inline-block px-5 py-2 rounded-full bg-[#f5e4e5] text-[#9c5c60] text-sm font-semibold tracking-wide"
          >
            ✨ No horseback riding experience necessary!
          </div>
        </div>

        <!-- 3 TAKEAWAYS / BENEFITS GRID -->
        <div class="grid md:grid-cols-3 gap-8">
          {
            benefits.map((item) => (
              <div class="bg-white rounded-2xl border border-dusty-pink/30 shadow-sm overflow-hidden flex flex-col hover:shadow-lg transition-all group">
                <div class="relative h-56 overflow-hidden">
                  <img
                    src={item.image}
                    alt={item.alt}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/90 backdrop-blur-md flex items-center justify-center text-[#c48b8e] shadow-md">
                    <Icon name={item.icon} class="w-5 h-5" />
                  </div>
                </div>
                <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                  <div class="space-y-2">
                    <h3 class="text-2xl font-serif text-[#3b2314] font-semibold">{item.title}</h3>
                    <p class="text-sm text-[#2c2c2c]/80 leading-relaxed">{item.description}</p>
                  </div>
                  <div class="pt-2 border-t border-black/5 flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-[#9c5c60]">
                    <span>Included Feature</span>
                    <Icon name="tabler:arrow-right" class="w-4 h-4 text-[#c48b8e]" />
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 5. TICKETING & BOOKING INTEGRATION SECTION -->
    <section class="py-20 px-6 bg-dusty-pink-subtle border-y border-dusty-pink/30">
      <div class="max-w-4xl mx-auto space-y-12">
        <div class="text-center space-y-4">
          <span class="text-xs uppercase tracking-[0.2em] font-semibold text-[#9c5c60] block">
            Reserve Your Time Slot
          </span>
          <h2 class="text-3xl sm:text-4xl font-serif text-[#3b2314] font-normal">Ticketing & Ride Registration</h2>
          <p class="text-base text-[#2c2c2c]/85 max-w-xl mx-auto">
            Book your ride in advance and choose your preferred time slot — your horse and wrangler will be ready for
            your scheduled ride.
          </p>
        </div>

        <!-- Ticket Card -->
        <div class="bg-white rounded-3xl border-2 border-dusty-pink shadow-xl overflow-hidden">
          <!-- Card Header -->
          <div
            class="bg-[#3b2314] text-white p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
          >
            <div>
              <span
                class="inline-block px-3 py-1 rounded-full text-xs font-semibold tracking-wider uppercase badge-pink mb-2"
              >
                Horseback Ride Add-On
              </span>
              <h3 class="text-2xl sm:text-3xl font-serif font-normal text-white">Horseback Ride Add-On Ticket</h3>
              <p class="text-xs text-white/70 tracking-wide">Matcha on Ice × Rustic Ranch Pop-Up</p>
            </div>
            <div class="text-left sm:text-right">
              <span class="block text-4xl sm:text-5xl font-serif font-bold text-[#c49a3c]">$25</span>
              <span class="block text-xs uppercase tracking-widest text-white/60">Until Sold Out</span>
            </div>
          </div>

          <!-- Card Body -->
          <div class="p-6 sm:p-10 space-y-8">
            <div class="grid sm:grid-cols-2 gap-6">
              <div class="space-y-3">
                <h4 class="text-sm font-semibold uppercase tracking-wider text-[#3b2314]">What's Included:</h4>
                <ul class="space-y-2 text-sm text-[#2c2c2c]/85">
                  <li class="flex items-center gap-2">
                    <Icon name="tabler:circle-check" class="w-5 h-5 text-[#c48b8e]" />
                    One 15-minute guided horseback ride
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="tabler:circle-check" class="w-5 h-5 text-[#c48b8e]" />
                    Trail wrangler guidance & safety gear
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="tabler:circle-check" class="w-5 h-5 text-[#c48b8e]" />
                    Reserved post-pilates ride window
                  </li>
                </ul>
              </div>

              <div class="space-y-3">
                <h4 class="text-sm font-semibold uppercase tracking-wider text-[#3b2314]">Event Location & Date:</h4>
                <div class="p-4 rounded-xl bg-[#faf7f2] border border-black/5 space-y-2 text-xs text-[#2c2c2c]/80">
                  <p class="flex items-center gap-2 font-medium text-[#3b2314]">
                    <Icon name="tabler:calendar" class="w-4 h-4 text-[#c48b8e]" />
                    Saturday, October 10, 2026
                  </p>
                  <p class="flex items-center gap-2">
                    <Icon name="tabler:map-pin" class="w-4 h-4 text-[#c48b8e]" />
                    14875 Mina De Oro Rd, Poway, CA 92064
                  </p>
                </div>
              </div>
            </div>

            <!-- Booking Actions -->
            <div class="pt-6 border-t border-black/10 flex flex-col sm:flex-row items-center justify-between gap-4">
              <div class="text-xs text-[#9c5c60] font-medium flex items-center gap-1.5">
                <Icon name="tabler:clock" class="w-4 h-4" />
                Select your preferred ride time window during checkout
              </div>
              <div class="flex items-center gap-3 w-full sm:w-auto">
                <a
                  href={BOOKING_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full sm:w-auto px-8 py-3.5 rounded-full btn-dusty-pink font-semibold text-xs uppercase tracking-widest text-center shadow-md"
                >
                  Book Now ($25)
                </a>
                <a
                  href={BOOKING_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hidden sm:inline-flex px-6 py-3.5 rounded-full bg-white border border-[#3b2314]/20 hover:border-[#3b2314]/50 text-[#3b2314] font-semibold text-xs uppercase tracking-widest text-center"
                >
                  Select Time
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. FAQS SECTION -->
    <section class="py-20 px-6">
      <div class="max-w-4xl mx-auto space-y-12">
        <div class="text-center space-y-3">
          <span class="text-xs uppercase tracking-[0.2em] font-semibold text-[#c48b8e]">Got Questions?</span>
          <h2 class="text-3xl sm:text-4xl font-serif text-[#3b2314] font-normal">Frequently Asked Questions</h2>
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          {
            faqs.map((faq) => (
              <div class="p-6 rounded-2xl bg-white border border-dusty-pink/30 space-y-2 shadow-sm">
                <h3 class="text-lg font-serif font-bold text-[#3b2314] flex items-start gap-2">
                  <Icon name="tabler:help-circle" class="w-5 h-5 text-[#c48b8e] shrink-0 mt-0.5" />
                  {faq.question}
                </h3>
                <p class="text-sm text-[#2c2c2c]/80 leading-relaxed pl-7">{faq.answer}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 7. FINAL CALL TO ACTION BANNER -->
    <section class="py-20 px-6 bg-[#3b2314] text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#c48b8e_1px,transparent_1px)] bg-size-[16px_16px]">
      </div>
      <div class="max-w-4xl mx-auto text-center space-y-8 relative z-10">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#f5e4e5]/20 text-[#f5e4e5] text-xs font-semibold uppercase tracking-widest border border-[#f5e4e5]/30"
        >
          October 10, 2026 • Poway, CA
        </div>
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-normal leading-tight">
          Ready to meet us in the saddle?
        </h2>
        <p class="text-lg text-white/80 max-w-2xl mx-auto leading-relaxed">
          Spots are limited to ensure a personal ranch experience. Reserve your $25 horseback ride today.
        </p>
        <div>
          <a
            href={BOOKING_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="px-10 py-5 rounded-full btn-dusty-pink font-semibold text-sm uppercase tracking-widest inline-flex items-center gap-3 shadow-xl"
          >
            <Icon name="tabler:ticket" class="w-5 h-5" />
            Reserve Your Ride ($25)
          </a>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
