---
import { Icon } from 'astro-icon/components';
import SiteLayout from '~/layouts/SiteLayout.astro';

const BOOK_URL = 'https://fareharbor.com/embeds/book/powaytrailcompany/items/71809/?full-items=yes&flow=31089';

const metadata = {
  // The brand suffix is appended by metadata.title.template in config.yaml.
  title: 'Kids Summer Camp',
  description:
    'Camps at the Ranch: a hands-on week of horseback riding, horsemanship, and outdoor adventure for kids in Poway, CA. Small groups, experienced instructors, ages 6–17.',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Camps at the Ranch – San Diego Trail Company',
  description: 'Weekday summer horse camp for kids in Poway, CA — riding, horsemanship, and ranch life.',
  provider: { '@type': 'LocalBusiness', name: 'San Diego Trail Company', url: 'https://www.sandiegotrailcompany.com' },
  areaServed: { '@type': 'City', name: 'Poway', addressRegion: 'CA' },
};

const facts = [
  { value: 'Ages 6–17', label: 'Welcoming beginners to advanced riders' },
  { value: '20 Campers', label: 'Max group size, per session' },
  { value: 'Jun–Jul', label: 'Weekly camp season' },
  { value: 'Til 3 PM', label: 'Extended care available' },
];

const expect = [
  {
    title: 'Daily Riding Lessons',
    description: 'Every camper saddles up daily, with instruction focused on balance, control, and confidence in the arena.',
    icon: 'tabler:horse',
  },
  {
    title: 'Horsemanship & Care',
    description: 'Grooming, tacking, and groundwork — kids learn to handle a horse from the ground up, not just ride one.',
    icon: 'tabler:heart',
  },
  {
    title: 'Equine Education',
    description: 'Horse anatomy, behavior, and safety, taught in a way that sticks — because understanding the horse is half the ride.',
    icon: 'tabler:book',
  },
  {
    title: 'Trail Walks & Scavenger Hunts',
    description: 'Nature hikes and scavenger hunts get campers exploring the backcountry beyond the arena fence.',
    icon: 'tabler:map-pin',
  },
  {
    title: 'Arts & Crafts',
    description: 'Horse-themed craft projects round out the day with a creative outlet after the riding boots come off.',
    icon: 'tabler:palette',
  },
  {
    title: 'Games & Movement',
    description: 'Mounted games, stretching, and simple balance exercises keep the energy up and the week feeling like camp.',
    icon: 'tabler:mood-smile',
  },
];

const bringChecklist = [
  'Packed lunch, snacks, and a labeled water bottle',
  'Riding boots — closed-toe with a small heel (any closed-toe shoe works if boots aren’t on hand)',
  'Comfortable riding clothes — jeans or riding pants recommended',
  'Sunscreen and a hat',
  'An extra change of clothes (optional, but a good idea)',
];

const goodToKnow = [
  { text: 'Helmets are provided — riders just need their own boots.', icon: 'tabler:shield-check' },
  { text: 'No riding experience needed. We match every camper to a horse suited to their skill level.', icon: 'tabler:sparkles' },
  { text: 'A signed waiver must be on file before camp begins.', icon: 'tabler:file-check' },
  { text: 'A 200 lb weight limit applies for horseback riding.', icon: 'tabler:scale' },
];

const galleryTop = [
  { src: '/images/marketing/camp-portrait-arena-1.jpg', alt: 'A camper in a helmet poses on horseback in the riding arena' },
  { src: '/images/marketing/camp-obstacle-cones.jpg', alt: 'A camper rides through an arena obstacle course marked with orange cones' },
];

const galleryBottom = [
  { src: '/images/marketing/camp-arena-fog.jpg', alt: 'Two young campers ride single-file through a foggy arena at dawn' },
  { src: '/images/marketing/camp-portrait-hillside.jpg', alt: 'A camper rides past ranch buildings and hillside under a partly cloudy sky' },
  { src: '/images/marketing/camp-road-group.jpg', alt: 'A group of campers rides single-file along a paved ranch road' },
];

const faqs = [
  {
    q: 'Do they need prior riding experience?',
    a: 'Not at all — beginners are welcome. We match each camper with a horse suited to their skill level and provide step-by-step instruction all week.',
  },
  {
    q: 'What should my child wear and bring?',
    a: 'Closed-toe boots with a small heel, comfortable riding clothes, sunscreen, a hat, and a packed lunch with a labeled water bottle. Helmets are provided.',
  },
  {
    q: 'Is there an age or weight limit?',
    a: 'Camp welcomes riders ages 6–17. A 200 lb weight limit applies for horseback riding.',
  },
  {
    q: 'How many campers are in each session?',
    a: 'We cap each session at 20 campers to keep instruction personal and supervision easy.',
  },
  {
    q: 'Can parents stay and watch?',
    a: 'Parents are welcome to observe during drop-off and pick-up, but camp activities are designed for campers only.',
  },
  {
    q: 'What happens if it rains?',
    a: 'Camp continues with adjusted activities — indoor horse education, crafts, and games — and riding is modified for safety as needed.',
  },
  {
    q: 'Is lunch provided?',
    a: 'No — campers bring their own lunch, snacks, and water daily. Please label all personal items.',
  },
  {
    q: 'Is extended care available?',
    a: 'Yes. Extended care runs until 3:00 PM and must be arranged in advance; a late fee applies to pickups after 3:00 PM.',
  },
];
---

<SiteLayout metadata={metadata}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <!-- Hero -->
  <section aria-label="Kids summer camp hero" class="relative flex items-end overflow-hidden" style="height:80vh;min-height:560px;">
    <video
      aria-hidden="true"
      autoplay
      muted
      loop
      playsinline
      class="absolute inset-0 w-full h-full object-cover"
      style="object-position:top;"
      src="/videos/kids-camp-hero.mp4"></video>
    <div
      aria-hidden="true"
      class="absolute inset-0"
      style="background:linear-gradient(to top, rgba(30,12,4,0.85) 0%, rgba(0,0,0,0.3) 60%, transparent 100%);"
    >
    </div>
    <div class="relative w-full max-w-[1400px] mx-auto px-6 lg:px-12 pb-16 lg:pb-24">
      <div class="uppercase tracking-[0.2em] mb-4" style="font-size:11px;color:#8a9e7b;">Ride & Learn</div>
      <h1
        class="text-white mb-6"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(44px,7vw,80px);font-weight:300;line-height:1.1;max-width:720px;"
      >
        Camps at the Ranch
      </h1>
      <p class="text-white mb-8" style="font-size:18px;max-width:560px;opacity:0.88;line-height:1.7;">
        A fun, hands-on week of riding, horsemanship, and outdoor adventure that builds confidence, skills, and
        teamwork at the ranch. Camps run weekdays, beginning June 1 through the end of July.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href={BOOK_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full transition-all hover:brightness-110"
          style="background-color:#c49a3c;color:#3b2314;font-size:13px;font-weight:500;height:48px;padding-left:32px;padding-right:32px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
        >
          Book a Camp <Icon name="tabler:arrow-right" class="w-4 h-4" />
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center justify-center rounded-full border-2 transition-all hover:bg-white/10"
          style="border-color:rgba(255,255,255,0.6);color:#ffffff;font-size:13px;font-weight:500;height:48px;padding-left:32px;padding-right:32px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>

  <!-- Quick facts -->
  <section aria-label="Camp facts" class="px-6 lg:px-12 py-16 lg:py-20" style="background-color:#3b2314;">
    <div class="max-w-[1100px] mx-auto grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
      {
        facts.map((fact) => (
          <div>
            <div
              class="mb-2"
              style="font-family:'Cormorant Garamond',serif;font-size:clamp(24px,4vw,36px);font-weight:400;color:#c49a3c;"
            >
              {fact.value}
            </div>
            <div style="font-size:13px;color:rgba(255,255,255,0.75);letter-spacing:0.05em;">{fact.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- What to expect -->
  <section aria-label="What to expect at camp" class="px-6 lg:px-12 py-20 lg:py-28" style="background-color:#f5f0e8;">
    <div class="max-w-[800px] mx-auto text-center mb-16">
      <div class="uppercase tracking-[0.2em] mb-6" style="font-size:11px;color:#8a9e7b;">What to Expect</div>
      <h2
        class="mb-6"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(32px,4vw,48px);font-weight:400;color:#3b2314;line-height:1.25;"
      >
        Give your child a summer they'll never forget.
      </h2>
      <p style="font-size:17px;color:#2c2c2c;line-height:1.8;opacity:0.85;max-width:680px;margin:0 auto;">
        Our week-long camps combine horseback riding, horsemanship, and outdoor fun in a safe, structured, and
        supportive setting. Campers learn the foundations of horse care, grooming, tacking, and groundwork, while
        also building confidence, responsibility, and teamwork — with a mix of riding, hands-on education, and
        classic camp activities every single day.
      </p>
    </div>
    <div class="max-w-[1200px] mx-auto grid sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {
        expect.map((item) => (
          <div class="p-8 rounded-lg" style="background-color:#edeae0;">
            <Icon name={item.icon} class="w-7 h-7 mb-4" style="color:#c49a3c;" />
            <h3 class="mb-3" style="font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:400;color:#3b2314;">
              {item.title}
            </h3>
            <p style="font-size:15px;color:#2c2c2c;line-height:1.7;opacity:0.85;">{item.description}</p>
          </div>
        ))
      }
    </div>
    <div class="max-w-[1200px] mx-auto grid sm:grid-cols-2 gap-6">
      {
        galleryTop.map((img) => (
          <div role="img" aria-label={img.alt} class="h-[300px] rounded-lg bg-cover bg-top" style={`background-image:url(${img.src});`} />
        ))
      }
    </div>
  </section>

  <!-- What to bring / Good to know -->
  <section aria-label="What to bring and good to know" class="px-6 lg:px-12 py-20 lg:py-28" style="background-color:#edeae0;">
    <div class="max-w-[1100px] mx-auto grid lg:grid-cols-2 gap-12">
      <div>
        <div class="uppercase tracking-[0.2em] mb-6" style="font-size:11px;color:#8a9e7b;">What to Bring</div>
        <h2
          class="mb-6"
          style="font-family:'Cormorant Garamond',serif;font-size:clamp(26px,3vw,34px);font-weight:400;color:#3b2314;line-height:1.25;"
        >
          Pack light, pack smart.
        </h2>
        <ul class="space-y-4">
          {
            bringChecklist.map((item) => (
              <li class="flex items-start gap-3" style="font-size:15px;color:#2c2c2c;line-height:1.6;opacity:0.9;">
                <Icon name="tabler:circle-check" class="w-5 h-5 flex-shrink-0 mt-0.5" style="color:#c49a3c;" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <div class="uppercase tracking-[0.2em] mb-6" style="font-size:11px;color:#8a9e7b;">Good to Know</div>
        <h2
          class="mb-6"
          style="font-family:'Cormorant Garamond',serif;font-size:clamp(26px,3vw,34px);font-weight:400;color:#3b2314;line-height:1.25;"
        >
          A few things to plan around.
        </h2>
        <ul class="space-y-4">
          {
            goodToKnow.map((item) => (
              <li class="flex items-start gap-3" style="font-size:15px;color:#2c2c2c;line-height:1.6;opacity:0.9;">
                <Icon name={item.icon} class="w-5 h-5 flex-shrink-0 mt-0.5" style="color:#c49a3c;" />
                {item.text}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Camp week -->
  <section aria-label="Camp schedule" class="px-6 lg:px-12 py-20 lg:py-28" style="background-color:#3b2314;">
    <div class="max-w-[800px] mx-auto text-center mb-14">
      <div class="uppercase tracking-[0.2em] mb-6" style="font-size:11px;color:#8a9e7b;">Weekly Camp</div>
      <h2
        class="text-white"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,44px);font-weight:300;line-height:1.2;"
      >
        Weekly camps, June 1 through the end of July.
      </h2>
    </div>
    <div class="max-w-[560px] mx-auto p-10 rounded-lg text-center" style="background-color:#4a2e1a;">
      <h3 class="mb-1" style="font-family:'Cormorant Garamond',serif;font-size:26px;font-weight:400;color:#fff;">
        Weekly Camp
      </h3>
      <p class="mb-8" style="font-size:14px;color:rgba(255,255,255,0.65);">
        A safe, structured, and engaging week at the ranch.
      </p>
      <ul class="mb-8 space-y-3 text-left max-w-[340px] mx-auto">
        <li class="flex items-center gap-3" style="font-size:15px;color:#8a9e7b;">
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background-color:#c49a3c;" />Drop-off from 7:45 AM · Pick-up at 1:00 PM
        </li>
        <li class="flex items-center gap-3" style="font-size:15px;color:#8a9e7b;">
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background-color:#c49a3c;" />Ages 6–17, capped at 20 campers
        </li>
        <li class="flex items-center gap-3" style="font-size:15px;color:#8a9e7b;">
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background-color:#c49a3c;" />Horseback riding, horsemanship & equine education
        </li>
        <li class="flex items-center gap-3" style="font-size:15px;color:#8a9e7b;">
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background-color:#c49a3c;" />Extended care available until 3:00 PM
        </li>
        <li class="flex items-center gap-3" style="font-size:15px;color:#8a9e7b;">
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background-color:#c49a3c;" />5% sibling discount, same week
        </li>
      </ul>
      <a
        href={BOOK_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full w-full transition-all hover:brightness-110"
        style="background-color:#c49a3c;color:#3b2314;font-size:13px;font-weight:500;height:48px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
      >
        Book Camp
      </a>
    </div>
  </section>

  <!-- Camp week in photos -->
  <section aria-label="Camp week in photos" class="px-6 lg:px-12 py-20 lg:py-28" style="background-color:#f5f0e8;">
    <div class="max-w-[800px] mx-auto text-center mb-12">
      <div class="uppercase tracking-[0.2em] mb-6" style="font-size:11px;color:#8a9e7b;">Camp Week</div>
      <h2
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,40px);font-weight:400;color:#3b2314;line-height:1.25;"
      >
        A week that builds lifelong friendships.
      </h2>
    </div>
    <div class="max-w-[1200px] mx-auto grid sm:grid-cols-3 gap-6">
      {
        galleryBottom.map((img) => (
          <div role="img" aria-label={img.alt} class="h-[260px] rounded-lg bg-cover bg-top" style={`background-image:url(${img.src});`} />
        ))
      }
    </div>
  </section>

  <!-- FAQ -->
  <section aria-label="Camp questions" class="px-6 lg:px-12 py-20 lg:py-28" style="background-color:#3b2314;">
    <div class="max-w-[800px] mx-auto text-center mb-14">
      <div class="uppercase tracking-[0.2em] mb-6" style="font-size:11px;color:#8a9e7b;">Frequently Asked Questions</div>
      <h2
        class="text-white"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,44px);font-weight:300;line-height:1.2;"
      >
        Everything you need to know to prepare for camp.
      </h2>
    </div>
    <div class="max-w-[900px] mx-auto grid sm:grid-cols-2 gap-8">
      {
        faqs.map((item) => (
          <div>
            <h3 class="mb-2" style="font-family:'Cormorant Garamond',serif;font-size:19px;font-weight:400;color:#c49a3c;">
              {item.q}
            </h3>
            <p style="font-size:14px;color:rgba(255,255,255,0.75);line-height:1.7;">{item.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section aria-label="Book camp" class="px-6 lg:px-12 py-20 lg:py-24 text-center" style="background-color:#f5f0e8;">
    <div class="max-w-[640px] mx-auto">
      <div class="uppercase tracking-[0.2em] mb-5" style="font-size:11px;color:#8a9e7b;">Save Their Spot</div>
      <h2
        class="mb-6"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,44px);font-weight:400;color:#3b2314;line-height:1.2;"
      >
        Spots fill up fast every summer.
      </h2>
      <p class="mb-10" style="font-size:16px;color:#2c2c2c;line-height:1.8;opacity:0.8;">
        Reserve your child's week now — check live availability and book online.
      </p>
      <a
        href={BOOK_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full transition-all hover:brightness-110"
        style="background-color:#c49a3c;color:#3b2314;font-size:13px;font-weight:500;height:48px;padding-left:32px;padding-right:32px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
      >
        Book a Camp <Icon name="tabler:arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </section>
</SiteLayout>
