---
import SiteLayout from '~/layouts/SiteLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';

const BOOK_URL = 'https://fareharbor.com/embeds/book/powaytrailcompany/items/71809/?full-items=yes&flow=31089';

const metadata = {
  // The brand suffix is appended by metadata.title.template in config.yaml.
  title: 'Kids Summer Camp',
  description:
    'Enroll your kids in our summer horse camp in Poway, CA. Weekdays 8 AM–1 PM, June through July. They will learn horsemanship, riding skills, and make lifelong friends in a safe, fun environment.',
};
---

<SiteLayout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    tagline="Horse Camp in Poway, CA"
    title="Kids Summer Camp"
    subtitle="Give your child an unforgettable ranch experience filled with horsemanship, riding, and outdoor fun. Camps run weekdays from 8:00 AM to 1:00 PM, beginning June 1 through the end of July."
    actions={[
      { variant: 'primary', text: 'Book a Camp', href: BOOK_URL, target: '_blank' },
      { text: 'Contact Us', href: '/contact/' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1628043689405-b07db35be6b4?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxraWRzJTIwaG9yc2V8ZW58MXx8fHwxNzgxNjI4MTEzfDA&ixlib=rb-4.1.0&q=80&w=1080',
      alt: 'Kids having fun at horse camp',
    }}
  />

  <!-- Camp Details -->
  <Content
    title="What to Expect"
    subtitle="Our comprehensive program covers all aspects of horse care and riding."
    items={[
      {
        title: 'Daily Riding Lessons',
        description:
          'Campers receive daily instruction in the arena, focusing on balance, control, and basic riding skills.',
        icon: 'tabler:horse',
      },
      {
        title: 'Horsemanship & Care',
        description:
          'Kids learn how to groom, tack, feed, and properly care for horses, fostering a sense of responsibility.',
        icon: 'tabler:heart',
      },
      {
        title: 'Fun & Games',
        description:
          'We mix learning with fun! From mounted games to arts and crafts, every day brings a new adventure.',
        icon: 'tabler:mood-smile',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1553531580-652231e34e2c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwyfHxob3JzZWJhY2slMjBsZXNzb258ZW58MXx8fHwxNzgxNjI4MTEwfDA&ixlib=rb-4.1.0&q=80&w=1080',
      alt: 'Child learning to ride a horse',
    }}
  />

  <!-- Pricing -->
  <Pricing
    title="Camp Pricing & Schedule"
    subtitle="Weekly camps run weekdays, 8:00 AM to 1:00 PM, from June 1 through the end of July."
    prices={[
      {
        title: 'Weekly Camp',
        subtitle: 'A safe, structured, and engaging week at the ranch.',
        price: '475',
        period: '/ child / week',
        items: [
          { description: 'Weekdays, 8:00 AM - 1:00 PM' },
          { description: 'Horseback riding & horse care' },
          { description: 'Teamwork & confidence-building activities' },
          { description: '5% sibling discount for multiple campers, same week' },
        ],
        callToAction: {
          target: '_blank',
          text: 'Book Camp',
          href: BOOK_URL,
        },
      },
    ]}
  />

  <!-- FAQs -->
  <FAQs
    title="Frequently Asked Questions"
    subtitle="Everything you need to know to prepare for camp."
    items={[
      {
        title: 'What should my child wear?',
        description:
          'Campers must wear long pants (jeans or leggings) and closed-toe shoes with a small heel (boots are ideal). We provide ASTM-approved helmets.',
      },
      {
        title: 'Do they need prior riding experience?',
        description:
          'Not at all! Our camps are designed to accommodate all skill levels, from absolute beginners to more advanced riders.',
      },
      {
        title: 'What should we pack for the day?',
        description: 'Please pack a water bottle, sunscreen, and a packed lunch. Label all personal items.',
      },
      {
        title: 'Is extended care available?',
        description:
          'Yes. Extended care is available until 3:00 PM for an additional charge and must be arranged in advance. Late pickups after 3:00 PM will incur a $50 fee.',
      },
      {
        title: 'Is there a discount for siblings?',
        description:
          'Yes, we offer a 5% sibling discount for families registering more than one child from the same household for the same week.',
      },
    ]}
  />
</SiteLayout>
