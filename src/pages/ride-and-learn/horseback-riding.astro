---
import { Icon } from 'astro-icon/components';
import SiteLayout from '~/layouts/SiteLayout.astro';

const BOOK_URL = 'https://fareharbor.com/embeds/book/powaytrailcompany/items/659635/?full-items=yes&flow=no';

const metadata = {
  title: 'Horseback Riding in San Diego – Guided Trail Rides & Lessons in Poway, CA',
  description:
    'Book horseback riding in San Diego County. Guided canyon trail rides in small groups of six or fewer, plus private and group riding lessons for all skill levels in Poway, CA.',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Horseback Riding – San Diego Trail Company',
  description:
    'Guided horseback trail rides and riding lessons for all experience levels in the Poway backcountry, San Diego County.',
  provider: { '@type': 'LocalBusiness', name: 'San Diego Trail Company', url: 'https://www.sandiegotrailcompany.com' },
  areaServed: { '@type': 'City', name: 'Poway', addressRegion: 'CA' },
};

const facts = [
  { value: '6 or fewer', label: 'Riders per guided group' },
  { value: '30–90 min', label: 'Trail ride options' },
  { value: 'Ages 7+', label: 'Trail rides · pony rides 2–6' },
  { value: '220 lbs', label: 'Maximum rider weight' },
];

const rideWays = [
  {
    id: 'trail-riding',
    label: 'Trail & Scenic Riding',
    title: 'Guided Canyon Trail Rides',
    description:
      'Our signature backcountry rides wind through the golden hills and chaparral canyons of Poway. Choose a 30-minute, 1-hour, or 1.5-hour route, ridden in groups of six or fewer, with all equipment provided. Ages 7 and up.',
    details: ['30, 60 & 90-minute options', 'Groups of 6 or fewer', 'All equipment provided', 'Ages 7+'],
    video: '/videos/guided-horse-rides.mp4',
  },
  {
    id: 'lessons',
    label: 'Horse Lessons',
    title: 'Riding Lessons for All Levels',
    description:
      "Private and small-group lessons and monthly programs for beginner adults — no previous horse experience is necessary. Lessons include riding instruction, grooming and tacking, groundwork, and hands-on horse care.",
    details: ['Private & small-group formats', 'Beginner adults welcome', 'Monthly programs available'],
    video: '/videos/for-all-ages-horseback.mp4',
  },
];

const whyRide = [
  {
    title: 'Groups of six or fewer',
    description:
      'Small by design. You get real attention from your guide and a quiet trail instead of a nose-to-tail parade.',
    icon: 'tabler:users',
  },
  {
    title: 'Direct backcountry access',
    description:
      'Trails start at the property line. No trailering, no road time — you are in the canyon within minutes of mounting up.',
    icon: 'tabler:map-pin',
  },
  {
    title: 'Rescue horses, well matched',
    description:
      'Many of our horses came to us through rescue and rehabilitation. We pair every rider to a horse that suits their build, nerve, and experience.',
    icon: 'tabler:heart',
  },
];

const rideOptions = [
  {
    title: '30-Minute Ride',
    subtitle: 'Every day of the week',
    description: 'A quick taste of the backcountry — perfect for first-timers or a shorter visit.',
  },
  {
    title: '1-Hour Ride',
    subtitle: 'Weekdays & weekends',
    description: 'Our most popular route, with enough time to settle in and enjoy the canyon views.',
  },
  {
    title: '1.5-Hour Ride',
    subtitle: 'Weekdays & weekends',
    description: 'Reaches the higher ridgelines for the full golden-hour canyon experience.',
  },
  {
    title: 'Pony Rides',
    subtitle: 'Ages 2–6 · Mon, Thu & Fri, 10 AM',
    description: 'A gentle, led introduction to horses for the youngest riders in the family.',
  },
];

const lessonOptions = [
  { title: 'Single Lesson', subtitle: 'Try it out or ride occasionally' },
  { title: '1 Day / Week', subtitle: '1 ride + horsemanship instruction' },
  { title: '2 Days / Week', subtitle: 'Tue & Thu — ride + horsemanship' },
  { title: '3 Days / Week', subtitle: 'Mon, Wed & Fri — 1 ride per week' },
  { title: '4 Days / Week', subtitle: 'Mon–Thu — 2 rides per week' },
  { title: '5 Days / Week', subtitle: 'Mon–Fri — 2 rides per week' },
];

const faqs = [
  {
    q: 'Do I need any riding experience?',
    a: 'No. Our guided trail rides are built for first-timers as well as seasoned riders. Every ride starts with a safety and handling orientation, and your guide stays with the group the whole way.',
  },
  {
    q: 'What is the minimum age?',
    a: 'Guided trail rides are for ages 7 and up. Younger children (ages 2–6) can enjoy a pony ride, available Mondays, Thursdays, and Fridays at 10:00 AM, or join our kids camps and ranch birthday parties.',
  },
  {
    q: 'What should I wear?',
    a: 'Long pants and closed-toe shoes with a small heel are required — boots are ideal. Bring sunscreen, sunglasses, and a water bottle. We provide ASTM-approved helmets and all tack.',
  },
  {
    q: 'How long are the rides?',
    a: 'We offer 30-minute, 1-hour, and 1.5-hour trail ride options. The 1.5-hour ride reaches the higher ridgelines and is the better choice if you want the full canyon views.',
  },
  {
    q: 'Is there a weight limit for trail rides?',
    a: 'Yes, the maximum rider weight is 220 lbs.',
  },
  {
    q: 'Where are you located?',
    a: 'We are in Poway, in the backcountry of San Diego County — an easy drive from central San Diego, North County, and the coast.',
  },
];
---

<SiteLayout metadata={metadata}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <!-- Hero -->
  <section aria-label="Horseback riding hero" class="relative flex items-end overflow-hidden" style="height:80vh;min-height:560px;">
    <video
      aria-hidden="true"
      autoplay
      muted
      loop
      playsinline
      class="absolute inset-0 w-full h-full object-cover"
      src="/videos/horseback-riding-hero.mp4"></video>
    <div
      aria-hidden="true"
      class="absolute inset-0"
      style="background:linear-gradient(to top, rgba(30,12,4,0.85) 0%, rgba(0,0,0,0.3) 60%, transparent 100%);"
    >
    </div>
    <div class="relative w-full max-w-[1400px] mx-auto px-6 lg:px-12 pb-16 lg:pb-24">
      <div class="uppercase tracking-[0.2em] mb-4" style="font-size:11px;color:#8a9e7b;">Ride & Learn</div>
      <h1
        class="text-white mb-6"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(44px,7vw,80px);font-weight:300;line-height:1.1;max-width:760px;"
      >
        Horseback Riding in San Diego
      </h1>
      <p class="text-white mb-8" style="font-size:18px;max-width:560px;opacity:0.88;line-height:1.7;">
        Ride the golden hills and chaparral canyons of the Poway backcountry. Small groups, patient horses, and
        guides who know every ridge and ravine — whether it's your first time in the saddle or your five
        hundredth.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href={BOOK_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full transition-all hover:brightness-110"
          style="background-color:#c49a3c;color:#3b2314;font-size:13px;font-weight:500;height:48px;padding-left:32px;padding-right:32px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
        >
          Book a Ride <Icon name="tabler:arrow-right" class="w-4 h-4" />
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center justify-center rounded-full border-2 transition-all hover:bg-white/10"
          style="border-color:rgba(255,255,255,0.6);color:#ffffff;font-size:13px;font-weight:500;height:48px;padding-left:32px;padding-right:32px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>

  <!-- Quick facts -->
  <section aria-label="Horseback riding facts" class="px-6 lg:px-12 py-16 lg:py-20" style="background-color:#3b2314;">
    <div class="max-w-[1100px] mx-auto grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
      {
        facts.map((fact) => (
          <div>
            <div
              class="mb-2"
              style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,40px);font-weight:400;color:#c49a3c;"
            >
              {fact.value}
            </div>
            <div style="font-size:13px;color:rgba(255,255,255,0.75);letter-spacing:0.05em;">{fact.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Ways to ride -->
  <section aria-label="Ways to ride with us" style="background-color:#f5f0e8;">
    {
      rideWays.map((way, index) => (
        <article aria-label={way.title} class={`grid lg:grid-cols-2 ${index % 2 === 1 ? 'lg:grid-flow-dense' : ''}`}>
          <div
            class={`relative h-[380px] lg:h-auto overflow-hidden ${index % 2 === 1 ? 'lg:col-start-2' : ''}`}
            style="min-height:400px;"
          >
            <video
              aria-hidden="true"
              autoplay
              muted
              loop
              playsinline
              class="absolute inset-0 w-full h-full object-cover"
              src={way.video}
            />
          </div>
          <div
            class={`px-8 lg:px-16 xl:px-20 py-16 lg:py-20 flex flex-col justify-center ${index % 2 === 1 ? 'lg:col-start-1 lg:row-start-1' : ''}`}
            style={`background-color:${index % 2 === 0 ? '#f5f0e8' : '#edeae0'};`}
          >
            <div class="uppercase tracking-[0.2em] mb-4" style="font-size:11px;color:#8a9e7b;">
              {way.label}
            </div>
            <h2
              class="mb-5"
              style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,3.5vw,40px);font-weight:400;color:#3b2314;line-height:1.2;"
            >
              {way.title}
            </h2>
            <p style="font-size:16px;color:#2c2c2c;line-height:1.8;opacity:0.85;max-width:480px;" class="mb-8">
              {way.description}
            </p>
            <ul class="space-y-3">
              {way.details.map((detail) => (
                <li class="flex items-center gap-3" style="font-size:15px;color:#8a9e7b;">
                  <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background-color:#c49a3c;" />
                  {detail}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </section>

  <!-- Why ride with us -->
  <section aria-label="Why ride with San Diego Trail Company" class="px-6 lg:px-12 py-20 lg:py-28" style="background-color:#f5f0e8;">
    <div class="max-w-[800px] mx-auto text-center mb-16">
      <div class="uppercase tracking-[0.2em] mb-6" style="font-size:11px;color:#8a9e7b;">Why Ride With Us</div>
      <h2
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(32px,4vw,48px);font-weight:400;color:#3b2314;line-height:1.25;"
      >
        A ride that respects the horse and the rider.
      </h2>
    </div>
    <div class="max-w-[1200px] mx-auto grid lg:grid-cols-2 gap-0 rounded-lg overflow-hidden" style="background-color:#edeae0;">
      <video
        aria-hidden="true"
        autoplay
        muted
        loop
        playsinline
        class="h-[320px] lg:h-auto w-full object-cover"
        src="/videos/respecting-the-horses.mp4"></video>
      <div class="p-8 lg:p-12 grid sm:grid-cols-1 gap-8">
        {
          whyRide.map((item) => (
            <div>
              <Icon name={item.icon} class="w-6 h-6 mb-3" style="color:#c49a3c;" />
              <h3 class="mb-2" style="font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:400;color:#3b2314;">
                {item.title}
              </h3>
              <p style="font-size:14px;color:#2c2c2c;line-height:1.7;opacity:0.85;">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Ride options -->
  <section aria-label="Ride options" class="px-6 lg:px-12 py-20 lg:py-28" style="background-color:#3b2314;">
    <div class="max-w-[800px] mx-auto text-center mb-14">
      <div class="uppercase tracking-[0.2em] mb-6" style="font-size:11px;color:#8a9e7b;">Ride Options</div>
      <h2
        class="text-white"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,44px);font-weight:300;line-height:1.2;"
      >
        Pick the length that fits your day.
      </h2>
    </div>
    <div class="max-w-[1200px] mx-auto grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        rideOptions.map((option) => (
          <div class="p-8 rounded-lg text-center" style="background-color:#4a2e1a;">
            <h3 class="mb-1" style="font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:400;color:#fff;">
              {option.title}
            </h3>
            <p class="mb-4" style="font-size:13px;color:rgba(255,255,255,0.6);">{option.subtitle}</p>
            <p class="mb-6" style="font-size:14px;color:rgba(255,255,255,0.8);line-height:1.6;">{option.description}</p>
            <a
              href={BOOK_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center rounded-full w-full transition-all hover:brightness-110"
              style="background-color:#c49a3c;color:#3b2314;font-size:12px;font-weight:500;height:44px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
            >
              Book a Ride
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Adult lessons -->
  <section aria-label="Adult riding and horsemanship lessons" class="grid lg:grid-cols-2">
    <div
      role="img"
      aria-label="A companion shot of a woman and horses at the arena rail"
      class="h-[360px] lg:h-auto bg-cover bg-center lg:col-start-2"
      style="background-image:url(/images/marketing/arena-rail-portrait-2.jpg);min-height:400px;"
    />
    <div class="px-8 lg:px-16 xl:px-20 py-16 lg:py-20 flex flex-col justify-center lg:col-start-1 lg:row-start-1" style="background-color:#f5f0e8;">
      <div class="uppercase tracking-[0.2em] mb-4" style="font-size:11px;color:#8a9e7b;">Adult Riding Program</div>
      <h2
        class="mb-5"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,3.5vw,40px);font-weight:400;color:#3b2314;line-height:1.2;"
      >
        Horsemanship Lessons for Adults
      </h2>
      <p style="font-size:16px;color:#2c2c2c;line-height:1.8;opacity:0.85;max-width:480px;" class="mb-6">
        No previous experience necessary — we work with beginner adults every day. Learning to ride also means
        learning how to confidently handle, understand, and care for a horse. Every program day offers two riding
        groups, based on experience and horse availability, while non-riding days round out the program with
        groundwork, grooming, tacking, horse anatomy, and ranch chores — so riders leave as well-rounded horse
        people, not just riders.
      </p>
      <ul class="space-y-3">
        <li class="flex items-center gap-3" style="font-size:15px;color:#8a9e7b;">
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background-color:#c49a3c;" />Groom, tack & groundwork
        </li>
        <li class="flex items-center gap-3" style="font-size:15px;color:#8a9e7b;">
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background-color:#c49a3c;" />Mounted instruction & confidence-building
        </li>
        <li class="flex items-center gap-3" style="font-size:15px;color:#8a9e7b;">
          <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background-color:#c49a3c;" />Untack & after-ride horse care
        </li>
      </ul>
    </div>
  </section>

  <!-- Lesson formats -->
  <section aria-label="Lesson and program formats" class="px-6 lg:px-12 py-20 lg:py-28" style="background-color:#f5f0e8;">
    <div class="max-w-[800px] mx-auto text-center mb-14">
      <div class="uppercase tracking-[0.2em] mb-6" style="font-size:11px;color:#8a9e7b;">Lesson & Program Formats</div>
      <h2
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,44px);font-weight:400;color:#3b2314;line-height:1.2;"
      >
        From an occasional ride to a full weekly program.
      </h2>
    </div>
    <div class="max-w-[1200px] mx-auto grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        lessonOptions.map((option) => (
          <div class="p-8 rounded-lg text-center" style="background-color:#edeae0;">
            <h3 class="mb-1" style="font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:400;color:#3b2314;">
              {option.title}
            </h3>
            <p class="mb-6" style="font-size:14px;color:#2c2c2c;opacity:0.75;">{option.subtitle}</p>
            <a
              href="/contact/"
              class="inline-flex items-center justify-center rounded-full w-full border-2 transition-all hover:bg-[#3b2314] hover:text-white"
              style="border-color:#3b2314;color:#3b2314;font-size:12px;font-weight:500;height:44px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
            >
              Contact Us
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- FAQ -->
  <section aria-label="Horseback riding questions" class="px-6 lg:px-12 py-20 lg:py-28" style="background-color:#3b2314;">
    <div class="max-w-[800px] mx-auto text-center mb-14">
      <div class="uppercase tracking-[0.2em] mb-6" style="font-size:11px;color:#8a9e7b;">Questions</div>
      <h2
        class="text-white"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,44px);font-weight:300;line-height:1.2;"
      >
        What riders ask us most before their first visit.
      </h2>
    </div>
    <div class="max-w-[900px] mx-auto grid sm:grid-cols-2 gap-8">
      {
        faqs.map((item) => (
          <div>
            <h3 class="mb-2" style="font-family:'Cormorant Garamond',serif;font-size:19px;font-weight:400;color:#c49a3c;">
              {item.q}
            </h3>
            <p style="font-size:14px;color:rgba(255,255,255,0.75);line-height:1.7;">{item.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section aria-label="Book a ride" class="px-6 lg:px-12 py-20 lg:py-24 text-center" style="background-color:#f5f0e8;">
    <div class="max-w-[640px] mx-auto">
      <div class="uppercase tracking-[0.2em] mb-5" style="font-size:11px;color:#8a9e7b;">Ready When You Are</div>
      <h2
        class="mb-6"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,44px);font-weight:400;color:#3b2314;line-height:1.2;"
      >
        Ready to get in the saddle?
      </h2>
      <p class="mb-10" style="font-size:16px;color:#2c2c2c;line-height:1.8;opacity:0.8;">
        Check live availability and reserve your ride online.
      </p>
      <a
        href={BOOK_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full transition-all hover:brightness-110"
        style="background-color:#c49a3c;color:#3b2314;font-size:13px;font-weight:500;height:48px;padding-left:32px;padding-right:32px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
      >
        Book a Ride <Icon name="tabler:arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </section>
</SiteLayout>
