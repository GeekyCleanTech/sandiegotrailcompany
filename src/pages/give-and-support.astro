---
import { Icon } from 'astro-icon/components';
import SiteLayout from '~/layouts/SiteLayout.astro';

const metadata = {
  title: 'Give & Support – Donate, Sponsor & Adopt Rescue Horses in Poway, CA',
  description:
    'Support our 501(c) nonprofit horse rescue and rehabilitation mission. Donate, become an individual or corporate member, sponsor a horse, or adopt a rehabilitated horse in Poway, CA.',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'San Diego Trail Company – Give & Support',
  description:
    'A 501(c) nonprofit committed to the rescue, rehabilitation, and retirement of horses in Southern California.',
  url: 'https://www.sandiegotrailcompany.com',
  telephone: '+1-858-748-6441',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '14875 Mina De Oro',
    addressLocality: 'Poway',
    addressRegion: 'CA',
    postalCode: '92064',
    addressCountry: 'US',
  },
};

const giveHero = '/images/give-hero.jpg';

const missionStats = [
  { value: '200+', label: 'Horses rescued & rehabilitated' },
  { value: '501(c)', label: 'Certified nonprofit status' },
  { value: '15+ yrs', label: 'Of service to equine welfare' },
  { value: '100%', label: 'Donations go to horse care' },
];

const ways = [
  {
    id: 'donate',
    label: 'PTC Give 501(c)',
    title: 'Direct Donations & Grant Support',
    description:
      'Every dollar you give goes directly to the rescue, rehabilitation, and retirement of horses in need. As a certified 501(c) nonprofit, your donation is fully tax-deductible. Grants from businesses and foundations are welcomed and matched with full accountability reporting.',
    details: [
      'Tax-deductible contributions',
      'One-time & recurring options',
      'Transparent fund allocation',
      'Annual impact reports',
    ],
    cta: 'Donate Now',
    href: '/contact/',
    image: '/images/sdtc/direct-donations.jpg',
  },
  {
    id: 'individual',
    label: 'Individual Membership',
    title: 'Become a Ranch Supporter',
    description:
      'Individual sponsorship is the backbone of our mission. As a member, you receive behind-the-scenes access to our rescue horses, invitations to exclusive ranch events, and the knowledge that a real animal is better off because of you.',
    details: [
      'Named horse sponsorship',
      'Exclusive member events',
      'Quarterly photo updates',
      'Monthly & annual tiers',
    ],
    cta: 'Join as a Member',
    href: '/contact/',
    image: '/images/sdtc/ranch-supporter.jpg',
  },
  {
    id: 'corporate',
    label: 'Corporate Membership',
    title: 'Partner With a Purpose',
    description:
      'Align your brand with a mission that resonates. Corporate memberships provide meaningful CSR opportunities — from logo placement and employee volunteer days to named sponsorships of individual rescue horses and public recognition at ranch events.',
    details: [
      'Logo & brand recognition',
      'Employee volunteer programs',
      'Named horse sponsorships',
      'Custom partnership tiers',
    ],
    cta: 'Explore Corporate Partnerships',
    href: '/contact/',
    image: '/images/give-corporate.jpg',
  },
  {
    id: 'adoption',
    label: 'Horses For Sale',
    title: 'Adopt a Rehabilitated Horse',
    description:
      'Our horses available for sale are not just transactions — they are second chances. Each horse has been rescued, rehabilitated, and carefully assessed. We match riders with the right horse and stay connected after adoption to ensure lasting success.',
    details: [
      'Fully vetted & assessed horses',
      'All skill-level matches',
      'Post-adoption support',
      'Transparent health histories',
    ],
    cta: 'View Available Horses',
    href: '/contact/',
    image: '/images/sdtc/adopt-rehabilitated-horse.jpg',
  },
];
---

<SiteLayout metadata={metadata}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <!-- Hero -->
  <section aria-label="Give and Support hero" class="relative flex items-end" style="height:80vh;min-height:560px;">
    <div aria-hidden="true" class="absolute inset-0 bg-cover bg-center" style={`background-image:url(${giveHero});`}>
      <div
        class="absolute inset-0"
        style="background:linear-gradient(to top, rgba(30,12,4,0.88) 0%, rgba(0,0,0,0.35) 60%, transparent 100%);"
      >
      </div>
    </div>
    <div class="relative w-full max-w-[1400px] mx-auto px-6 lg:px-12 pb-16 lg:pb-24">
      <div class="uppercase tracking-[0.2em] mb-4" style="font-size:11px;color:#8a9e7b;">San Diego Trail Company</div>
      <h1
        class="text-white mb-6"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(44px,7vw,80px);font-weight:300;line-height:1.1;max-width:720px;"
      >
        Give & Support
      </h1>
      <p class="text-white mb-8" style="font-size:18px;max-width:520px;opacity:0.88;line-height:1.7;">
        Our ranch runs on more than passion — it runs on community. Join us in giving horses a second chance through
        donations, memberships, partnerships, and adoption.
      </p>
      <a
        href="/contact/"
        class="inline-flex items-center gap-2 rounded-full transition-all hover:brightness-110"
        style="background-color:#c49a3c;color:#3b2314;font-size:13px;font-weight:500;height:48px;padding-left:32px;padding-right:32px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
      >
        <Icon name="tabler:heart" class="w-4 h-4" /> Donate Today
      </a>
    </div>
  </section>

  <!-- Mission statement -->
  <section
    aria-label="Rescue Rehab Retire mission"
    class="px-6 lg:px-12 py-20 lg:py-28"
    style="background-color:#f5f0e8;"
  >
    <div class="max-w-[880px] mx-auto text-center">
      <div class="uppercase tracking-[0.2em] mb-6" style="font-size:11px;color:#8a9e7b;">Rescue · Rehab · Retire</div>
      <h2
        class="mb-8"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(32px,4vw,52px);font-weight:400;color:#3b2314;line-height:1.2;"
      >
        Every horse deserves a second chance.
      </h2>
      <p style="font-size:18px;color:#2c2c2c;line-height:1.8;opacity:0.85;">
        The San Diego Trail Company was founded on a commitment to horses that have been neglected, abandoned, or
        misused. Our Rescue, Rehab, Retire mission provides these animals with veterinary care, patient rehabilitation,
        and — whenever possible — a loving new home or a peaceful retirement on the ranch. Your support makes it
        possible.
      </p>
    </div>
  </section>

  <!-- Mission stats -->
  <section aria-label="Mission impact statistics" class="px-6 lg:px-12 py-16" style="background-color:#3b2314;">
    <dl class="max-w-[1200px] mx-auto grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-4 text-center">
      {
        missionStats.map((stat) => (
          <div>
            <dt
              class="mb-2"
              style="font-family:'Cormorant Garamond',serif;font-size:clamp(36px,5vw,56px);font-weight:300;color:#c49a3c;line-height:1;"
            >
              {stat.value}
            </dt>
            <dd style="font-size:13px;color:rgba(255,255,255,0.65);letter-spacing:0.05em;">{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Ways to give -->
  <section aria-label="Ways to give and support" style="background-color:#f5f0e8;">
    {
      ways.map((way, index) => (
        <article aria-label={way.title} class={`grid lg:grid-cols-2 ${index % 2 === 1 ? 'lg:grid-flow-dense' : ''}`}>
          <div
            role="img"
            aria-label={`${way.title} – photo`}
            class={`h-[360px] lg:h-auto bg-cover bg-center ${index % 2 === 1 ? 'lg:col-start-2' : ''}`}
            style={`background-image:url(${way.image});min-height:380px;`}
          />
          <div
            class={`px-8 lg:px-16 xl:px-20 py-16 lg:py-20 flex flex-col justify-center ${index % 2 === 1 ? 'lg:col-start-1 lg:row-start-1' : ''}`}
            style={`background-color:${index % 2 === 0 ? '#f5f0e8' : '#edeae0'};`}
          >
            <div class="uppercase tracking-[0.2em] mb-4" style="font-size:11px;color:#8a9e7b;">
              {way.label}
            </div>
            <h3
              class="mb-5"
              style="font-family:'Cormorant Garamond',serif;font-size:clamp(26px,3vw,38px);font-weight:400;color:#3b2314;line-height:1.2;"
            >
              {way.title}
            </h3>
            <p class="mb-8" style="font-size:16px;color:#2c2c2c;line-height:1.8;opacity:0.85;max-width:480px;">
              {way.description}
            </p>
            <ul class="mb-10 space-y-3">
              {way.details.map((d) => (
                <li class="flex items-center gap-3" style="font-size:15px;color:#8a9e7b;">
                  <span class="w-1.5 h-1.5 rounded-full flex-shrink-0" style="background-color:#c49a3c;" />
                  {d}
                </li>
              ))}
            </ul>
            <a
              href={way.href}
              class="inline-flex items-center gap-2 hover:gap-3 transition-all"
              style="font-size:13px;color:#c49a3c;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
            >
              {way.cta} <Icon name="tabler:arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </article>
      ))
    }
  </section>

  <!-- Cross-sell -->
  <section
    aria-label="Cross promotion – Come meet the horses"
    class="relative overflow-hidden"
    style="background-color:#8a9e7b;"
  >
    <div class="px-6 lg:px-12 py-20 lg:py-24 text-center max-w-[700px] mx-auto">
      <div class="uppercase tracking-[0.2em] mb-5" style="font-size:11px;color:rgba(255,255,255,0.7);">
        Experience the Mission
      </div>
      <h2
        class="text-white mb-6"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(28px,4vw,48px);font-weight:300;line-height:1.2;"
      >
        Come meet the horses you're helping.
      </h2>
      <p class="mb-10" style="font-size:16px;color:rgba(255,255,255,0.85);line-height:1.8;">
        The best way to understand our mission is to experience it firsthand. Book a trail ride or a ranch stay and
        witness our rescue horses thriving in the Poway backcountry.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/ride-and-learn/"
          class="inline-flex items-center justify-center gap-2 rounded-full transition-all hover:brightness-110"
          style="background-color:#c49a3c;color:#3b2314;font-size:13px;font-weight:500;height:48px;padding-left:28px;padding-right:28px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
        >
          Book a Ride <Icon name="tabler:arrow-right" class="w-4 h-4" />
        </a>
        <a
          href="/stay-and-celebrate/"
          class="inline-flex items-center justify-center gap-2 rounded-full transition-all"
          style="border:1px solid rgba(255,255,255,0.6);color:#fff;font-size:13px;font-weight:500;height:48px;padding-left:28px;padding-right:28px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
        >
          Plan a Stay <Icon name="tabler:arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
