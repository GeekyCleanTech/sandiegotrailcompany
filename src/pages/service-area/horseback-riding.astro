---
import SiteLayout from '~/layouts/SiteLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Pricing from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const BOOK_URL = 'https://fareharbor.com/embeds/book/powaytrailcompany/items/659635/?full-items=yes&flow=no';

const metadata = {
  title: 'Horseback Riding in San Diego – Guided Trail Rides & Lessons in Poway, CA',
  description:
    'Book horseback riding in San Diego County. Guided canyon trail rides in small groups of six or fewer, plus private and group riding lessons for all skill levels in Poway, CA.',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Horseback Riding – San Diego Trail Company',
  description:
    'Guided horseback trail rides and riding lessons for all experience levels in the Poway backcountry, San Diego County.',
  provider: { '@type': 'LocalBusiness', name: 'San Diego Trail Company', url: 'https://www.sandiegotrailcompany.com' },
  areaServed: { '@type': 'City', name: 'Poway', addressRegion: 'CA' },
};
---

<SiteLayout metadata={metadata}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Hero
    tagline="Horseback Riding in Poway, CA"
    title="Horseback Riding in San Diego"
    subtitle="Ride the golden hills and chaparral canyons of the Poway backcountry. Small groups, patient horses, and guides who know every ridge and ravine — whether it's your first time in the saddle or your five hundredth."
    actions={[
      { variant: 'primary', text: 'Book a Ride', href: BOOK_URL, target: '_blank' },
      { text: 'Contact Us', href: '/contact/' },
    ]}
    image={{
      src: '/images/ride-trail.jpg',
      alt: 'Riders on a guided horseback trail ride through a San Diego canyon',
    }}
  />

  <Content
    title="Ways to Ride With Us"
    subtitle="Two paths into horsemanship — pick the one that fits where you are today."
    items={[
      {
        title: 'Guided Canyon Trail Rides',
        description:
          'Our signature backcountry rides wind through the golden hills and chaparral canyons of Poway. 30-minute, 1-hour, and 1.5-hour options starting at $65 per person, groups of six or fewer, and all equipment provided. Ages 7 and up.',
        icon: 'tabler:horse',
      },
      {
        title: 'Riding Lessons for All Levels',
        description:
          "Private and small-group lessons and monthly programs starting at $110. We work with beginner adults, so no previous horse experience is necessary — lessons include riding instruction, grooming and tacking, groundwork, and hands-on horse care.",
        icon: 'tabler:school',
      },
      {
        title: 'First-Time Riders Welcome',
        description:
          'No experience necessary. Every ride begins with a hands-on safety and handling orientation, and our guides stay with you from mounting block to finish.',
        icon: 'tabler:mood-smile',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1763130063689-06fbdb789db8?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwzfHxob3JzZSUyMGxlc3NvbnMlMjBlcXVlc3RyaWFuJTIwdHJhaW5pbmclMjByaWRpbmclMjBhcmVuYXxlbnwxfHx8fDE3ODA4MzI2MDl8MA&ixlib=rb-4.1.0&q=80&w=1080',
      alt: 'A rider taking a horseback riding lesson in the arena',
    }}
  />

  <Content
    isReversed
    isAfterContent
    title="Why Ride With San Diego Trail Company"
    items={[
      {
        title: 'Groups of six or fewer',
        description:
          'Small by design. You get real attention from your guide and a quiet trail instead of a nose-to-tail parade.',
        icon: 'tabler:users',
      },
      {
        title: 'Direct backcountry access',
        description:
          'Trails start at the property line. No trailering, no road time — you are in the canyon within minutes of mounting up.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Rescue horses, well matched',
        description:
          'Many of our horses came to us through rescue and rehabilitation. We pair every rider to a horse that suits their build, nerve, and experience.',
        icon: 'tabler:heart',
      },
    ]}
    image={{
      src: '/images/pillar-ride-learn.png',
      alt: 'Horses and riders at the San Diego Trail Company ranch in Poway',
    }}
  />

  <!-- Trail Ride Pricing -->
  <Pricing
    title="Trail Ride Pricing"
    subtitle="For ages 7 and up. Maximum rider weight is 220 lbs. All rides are by reservation only."
    prices={[
      {
        title: '30-Minute Ride',
        subtitle: 'New option — every day of the week.',
        price: '65',
        period: '/ person',
        items: [{ description: 'Available weekdays and weekends' }],
        callToAction: { target: '_blank', text: 'Book a Ride', href: BOOK_URL },
      },
      {
        title: '1-Hour Ride',
        subtitle: 'Weekdays (Mon–Thu)',
        price: '110',
        period: '/ person',
        callToAction: { target: '_blank', text: 'Book a Ride', href: BOOK_URL },
      },
      {
        title: '1-Hour Ride',
        subtitle: 'Weekends (Fri–Sun)',
        price: '125',
        period: '/ person',
        callToAction: { target: '_blank', text: 'Book a Ride', href: BOOK_URL },
      },
      {
        title: '1.5-Hour Ride',
        subtitle: 'Weekdays (Mon–Thu)',
        price: '165',
        period: '/ person',
        callToAction: { target: '_blank', text: 'Book a Ride', href: BOOK_URL },
      },
      {
        title: '1.5-Hour Ride',
        subtitle: 'Weekends (Fri–Sun)',
        price: '167.50',
        period: '/ person',
        callToAction: { target: '_blank', text: 'Book a Ride', href: BOOK_URL },
      },
      {
        title: 'Pony Rides',
        subtitle: 'Ages 2–6, Mon, Thu & Fri at 10:00 AM',
        price: '40',
        period: '/ 30 min ride',
        callToAction: { target: '_blank', text: 'Book a Pony Ride', href: BOOK_URL },
      },
    ]}
  />

  <!-- Adult Lesson Program -->
  <Content
    isReversed
    title="Adult Riding & Horsemanship Lessons"
    subtitle="No previous experience necessary — we work with beginner adults every day."
    content="Our program is a little different from a traditional riding school. We believe learning to ride also means learning how to confidently handle, understand, and care for a horse. Every program day offers two riding groups, 3:30 PM and 4:30 PM, based on experience and horse availability — while one group rides, the other works on horsemanship and hands-on horse care. Non-riding days round out the program with groundwork, grooming, tacking, horse anatomy, feeding and nutrition, and ranch chores, so riders leave as well-rounded horse people, not just riders."
    items={[
      {
        title: 'Groom, tack & groundwork',
        description: 'Learn to groom, pick hooves, saddle and bridle, and handle your horse from the ground up.',
        icon: 'tabler:hand-stop',
      },
      {
        title: 'Mounted instruction',
        description: 'Balance, position, steering, stopping, transitions, and confidence-building in the saddle.',
        icon: 'tabler:horse',
      },
      {
        title: 'Untack & horse care',
        description: 'Cool down, untack, groom, and learn proper after-ride care and equipment upkeep.',
        icon: 'tabler:heart',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1763130063689-06fbdb789db8?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwzfHxob3JzZSUyMGxlc3NvbnMlMjBlcXVlc3RyaWFuJTIwdHJhaW5pbmclMjByaWRpbmclMjBhcmVuYXxlbnwxfHx8fDE3ODA4MzI2MDl8MA&ixlib=rb-4.1.0&q=80&w=1080',
      alt: 'An adult beginner taking a horsemanship lesson',
    }}
  />

  <!-- Lesson Pricing -->
  <Pricing
    title="Lesson & Program Pricing"
    subtitle="Once enrolled in a monthly program, additional rides are $35 each, subject to horse and instructor availability."
    prices={[
      {
        title: 'Single Lesson',
        subtitle: 'Perfect for trying it out or an occasional ride.',
        price: '110',
        period: '/ lesson',
        callToAction: { text: 'Contact Us', href: '/contact/' },
      },
      {
        title: '1 Day / Week',
        subtitle: '1 ride per week, plus horsemanship instruction.',
        price: '300',
        period: '/ month',
        callToAction: { text: 'Contact Us', href: '/contact/' },
      },
      {
        title: '2 Days / Week',
        subtitle: 'Tue & Thu — 1 ride, plus a hands-on horsemanship day.',
        price: '300',
        period: '/ month',
        callToAction: { text: 'Contact Us', href: '/contact/' },
      },
      {
        title: '3 Days / Week',
        subtitle: 'Mon, Wed & Fri — 1 ride per week.',
        price: '415',
        period: '/ month',
        callToAction: { text: 'Contact Us', href: '/contact/' },
      },
      {
        title: '4 Days / Week',
        subtitle: 'Mon–Thu — 2 rides per week.',
        price: '490',
        period: '/ month',
        callToAction: { text: 'Contact Us', href: '/contact/' },
      },
      {
        title: '5 Days / Week',
        subtitle: 'Mon–Fri — 2 rides per week.',
        price: '540',
        period: '/ month',
        callToAction: { text: 'Contact Us', href: '/contact/' },
      },
    ]}
  />

  <FAQs
    title="Horseback Riding Questions"
    subtitle="What riders ask us most before their first visit."
    items={[
      {
        title: 'Do I need any riding experience?',
        description:
          'No. Our guided trail rides are built for first-timers as well as seasoned riders. Every ride starts with a safety and handling orientation, and your guide stays with the group the whole way.',
      },
      {
        title: 'What is the minimum age?',
        description:
          'Guided trail rides are for ages 7 and up. Younger children (ages 2–6) can enjoy a pony ride, available Mondays, Thursdays, and Fridays at 10:00 AM, or join our kids camps and ranch birthday parties.',
      },
      {
        title: 'What should I wear?',
        description:
          'Long pants and closed-toe shoes with a small heel are required — boots are ideal. Bring sunscreen, sunglasses, and a water bottle. We provide ASTM-approved helmets and all tack.',
      },
      {
        title: 'How long are the rides?',
        description:
          'We offer 30-minute, 1-hour, and 1.5-hour trail ride options. The 1.5-hour ride reaches the higher ridgelines and is the better choice if you want the full canyon views.',
      },
      {
        title: 'Is there a weight limit for trail rides?',
        description: 'Yes, the maximum rider weight is 220 lbs.',
      },
      {
        title: 'Where are you located?',
        description:
          'We are in Poway, in the backcountry of San Diego County — an easy drive from central San Diego, North County, and the coast.',
      },
    ]}
  />

  <CallToAction
    title="Ready to get in the saddle?"
    subtitle="Check live availability and reserve your ride online."
    actions={[{ variant: 'primary', text: 'Book a Ride', href: BOOK_URL, target: '_blank' }]}
  />
</SiteLayout>
