---
import SiteLayout from '~/layouts/SiteLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Equus Coaching in San Diego – Equine-Assisted Personal Growth in Poway, CA',
  description:
    'Equus coaching in Poway, CA. Equine-assisted sessions for self-awareness, leadership, and emotional resilience — for individuals, groups, and corporate teams. No riding experience required.',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Equus Coaching – San Diego Trail Company',
  description:
    'Equine-assisted coaching for personal growth, leadership, and emotional resilience in Poway, San Diego County. No riding experience required.',
  provider: { '@type': 'LocalBusiness', name: 'San Diego Trail Company', url: 'https://www.sandiegotrailcompany.com' },
  areaServed: { '@type': 'City', name: 'Poway', addressRegion: 'CA' },
};
---

<SiteLayout metadata={metadata}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Hero
    tagline="Equus Coaching in Poway, CA"
    title="Equine-Assisted Personal Growth"
    subtitle="Horses are extraordinary mirrors of human emotion. They respond to what you are actually feeling rather than what you are presenting — which makes them remarkable partners for the work of understanding yourself."
    actions={[
      { variant: 'primary', text: 'Inquire About a Session', href: '/contact/' },
      { text: 'See All Programs', href: '/ride-and-learn/' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1599635406076-0f40532a59fc?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxob3JzZSUyMHJlc2N1ZSUyMHJlaGFiaWxpdGF0aW9uJTIwcGFzdHVyZSUyMHN1bnJpc2V8ZW58MXx8fHwxNzgwODMyNjAxfDA&ixlib=rb-4.1.0&q=80&w=1080',
      alt: 'A horse standing calmly in a pasture at sunrise during an Equus coaching session',
    }}
  />

  <Content
    title="What Equus Coaching Is"
    subtitle="Groundwork for the mind. No riding, no prior horse experience, no performance to get right."
    items={[
      {
        title: 'The horse reads the room',
        description:
          'Horses are prey animals, exquisitely tuned to intention and inconsistency. When your words and your body disagree, the horse responds to the body — and that gap becomes something you can finally see and work with.',
        icon: 'tabler:eye',
      },
      {
        title: 'Guided by a certified coach',
        description:
          'Sessions are led by a certified Equus coach who frames the exercise, reads the interaction alongside you, and helps you translate what happened in the arena into what happens in your life.',
        icon: 'tabler:compass',
      },
      {
        title: 'Feet on the ground',
        description:
          'All work is done from the ground. You will not be asked to ride, and there is nothing to master. The horse is a partner in the conversation, not equipment to operate.',
        icon: 'tabler:shoe',
      },
    ]}
    image={{
      src: '/images/pillar-ride-learn.png',
      alt: 'Groundwork with a horse during an equine-assisted coaching session',
    }}
  />

  <Steps
    title="How a Session Works"
    items={[
      {
        title: 'Arrive and set an intention',
        description:
          'We start away from the horses with a short conversation about what you want to look at — a decision, a pattern, a relationship, a role you are stepping into.',
        icon: 'tabler:message-circle',
      },
      {
        title: 'Meet the horse',
        description:
          'You enter the arena and simply be with the horse. No agenda at first. Most people notice the animal responding to something in them before a single exercise begins.',
        icon: 'tabler:horse',
      },
      {
        title: 'Work the exercise',
        description:
          'Your coach introduces a simple task — inviting the horse to follow, asking it to move, holding a boundary. How the horse answers tells you something true about how you are showing up.',
        icon: 'tabler:target-arrow',
      },
      {
        title: 'Make it portable',
        description:
          'We close by naming what surfaced and translating it into something you can actually use on Monday morning.',
        icon: 'tabler:notebook',
      },
    ]}
    image={{
      src: '/images/ride-trail.jpg',
      alt: 'The arena and open country at the Poway ranch',
    }}
  />

  <Content
    isReversed
    title="Who It's For"
    items={[
      {
        title: 'Individuals',
        description:
          'People navigating a transition, a hard decision, burnout, or a pattern they keep running into. One-to-one sessions, entirely private.',
        icon: 'tabler:user',
      },
      {
        title: 'Groups & families',
        description:
          'Small-group sessions that surface how people communicate with each other — often faster and more honestly than a conversation around a table would.',
        icon: 'tabler:users',
      },
      {
        title: 'Corporate & leadership teams',
        description:
          'Leadership, trust, and communication work for teams. Horses do not care about job titles, which is precisely what makes the exercise useful.',
        icon: 'tabler:briefcase',
      },
    ]}
    image={{
      src: '/images/give-corporate.jpg',
      alt: 'A corporate team taking part in an equine-assisted leadership session',
    }}
  />

  <FAQs
    title="Equus Coaching Questions"
    subtitle="What people ask before booking a first session."
    items={[
      {
        title: 'Do I need riding experience?',
        description:
          'None at all. Equus coaching is done entirely from the ground and involves no riding. Many participants have never been near a horse before their first session.',
      },
      {
        title: 'Is this therapy?',
        description:
          'No. Equus coaching is a coaching practice focused on self-awareness, leadership, and communication — it is not psychotherapy and is not a substitute for mental health treatment. If you are looking for clinical care, please work with a licensed professional.',
      },
      {
        title: 'What if I am nervous around horses?',
        description:
          'That is a perfectly good starting point, and often a productive one. Your coach controls the pace entirely, and nothing happens until you are ready for it.',
      },
      {
        title: 'How long is a session?',
        description:
          'Sessions are scheduled individually around your goals and whether you are coming alone, as a group, or with a team. Get in touch and we will build the right format with you.',
      },
      {
        title: 'Can you run this for our company?',
        description:
          'Yes. We run corporate and leadership programs for teams, and can combine a coaching session with a guided trail ride or a full ranch day. Contact us and we will scope it.',
      },
      {
        title: 'What should I wear?',
        description:
          'Closed-toe shoes and clothes you do not mind getting dusty. You will be standing on arena footing, outdoors, so dress for the weather and bring water.',
      },
    ]}
  />

  <CallToAction
    title="Curious what a horse would notice about you?"
    subtitle="Tell us what you're working on and we'll build a session around it."
    actions={[{ variant: 'primary', text: 'Inquire About a Session', href: '/contact/' }]}
  />
</SiteLayout>
