---
import { getCollection, render } from 'astro:content';
import SiteLayout from '~/layouts/SiteLayout.astro';
import PostShare from '~/components/blog/PostShare.astro';
import { buildPostMetadata, buildPostJsonLd } from '~/utils/postMeta';

export async function getStaticPaths() {
  const posts = await getCollection('post', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmtDate = (d?: Date) =>
  d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';

const metadata = buildPostMetadata(post);

const { video } = post.data;
const videoUrl = video && String(new URL(video.src, Astro.site));
const shareUrl = String(new URL(Astro.url.pathname, Astro.site));
const jsonLd = buildPostJsonLd(post, shareUrl, Astro.site);
const share = {
  url: shareUrl,
  title: post.data.title,
  summary: post.data.excerpt ?? metadata.description,
  video: video && { src: video.src, filename: `${post.id}.mp4` },
};
---

<SiteLayout metadata={metadata}>
  <Fragment slot="head">
    {post.data.publishDate && <meta property="article:published_time" content={post.data.publishDate.toISOString()} />}
    {post.data.updateDate && <meta property="article:modified_time" content={post.data.updateDate.toISOString()} />}
    {post.data.category && <meta property="article:section" content={post.data.category} />}
    {post.data.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    {
      video && (
        <>
          <meta property="og:video" content={videoUrl} />
          <meta property="og:video:secure_url" content={videoUrl} />
          <meta property="og:video:type" content="video/mp4" />
          {video.width && <meta property="og:video:width" content={String(video.width)} />}
          {video.height && <meta property="og:video:height" content={String(video.height)} />}
        </>
      )
    }
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <!-- Header band -->
  <section class="px-6 lg:px-12 pt-32 pb-12 lg:pt-40 lg:pb-14" style="background-color:#3b2314;">
    <div class="max-w-[760px] mx-auto">
      {
        post.data.category && (
          <div class="uppercase tracking-[0.2em] mb-4" style="font-size:11px;color:#8a9e7b;">
            {post.data.category}
          </div>
        )
      }
      <h1
        class="text-white mb-5"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(34px,5.5vw,56px);font-weight:300;line-height:1.12;"
      >
        {post.data.title}
      </h1>
      <div style="font-size:13px;color:rgba(255,255,255,0.6);letter-spacing:0.05em;">
        {fmtDate(post.data.publishDate)}{post.data.author ? ` · ${post.data.author}` : ''}
      </div>
    </div>
  </section>

  <article class="px-6 lg:px-12 py-14 lg:py-20" style="background-color:#f5f0e8;">
    <div class="max-w-[760px] mx-auto">
      <PostShare {...share} class="mb-8" />
      {
        video ? (
          <figure class="mb-10">
            <video
              class="post-video w-full rounded-lg mx-auto"
              style="max-width:560px;background-color:#3b2314;"
              src={video.src}
              poster={video.poster}
              width={video.width}
              height={video.height}
              aria-label={video.label}
              autoplay
              muted
              loop
              playsinline
              controls
              preload="metadata"
            />
            {video.caption && (
              <figcaption class="text-center mt-3" style="font-size:13px;color:rgba(44,44,44,0.66);">
                {video.caption}
              </figcaption>
            )}
          </figure>
        ) : (
          post.data.image && (
            <img
              src={post.data.image}
              alt={post.data.title}
              class="w-full rounded-lg mb-10"
              style="max-height:460px;object-fit:cover;"
              loading="lazy"
              decoding="async"
            />
          )
        )
      }
      <div class="post-body">
        <Content />
      </div>

      <div
        class="mt-14 pt-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6"
        style="border-top:1px solid rgba(59,35,20,0.12);"
      >
        <PostShare {...share} />
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 hover:gap-3 transition-all"
          style="font-size:13px;color:#c49a3c;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
        >
          ← Back to the Journal
        </a>
      </div>
    </div>
  </article>
</SiteLayout>

<script>
  // Featured videos autoplay on loop; hold them on the poster for visitors who prefer reduced motion.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.post-video').forEach((v) => {
      v.removeAttribute('autoplay');
      v.pause();
    });
  }
</script>

<style>
  .post-body :global(figure) {
    margin: 2em 0;
  }
  .post-body :global(figure img) {
    width: 100%;
    border-radius: 0.5rem;
  }
  .post-body :global(figcaption) {
    font-size: 13px;
    color: rgba(44, 44, 44, 0.66);
    margin-top: 0.6em;
  }
  .post-body :global(.post-cta) {
    margin: 2em 0;
  }
  .post-body :global(.post-cta p) {
    margin: 0;
    font-size: inherit;
    color: inherit;
    line-height: inherit;
  }
  .post-body :global(.post-cta a) {
    text-decoration: none;
  }
  .post-body :global(p) {
    font-size: 17px;
    color: #2c2c2c;
    line-height: 1.85;
    margin-bottom: 1.4em;
  }
  .post-body :global(h2) {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(26px, 3.5vw, 34px);
    font-weight: 400;
    color: #3b2314;
    line-height: 1.2;
    margin-top: 1.8em;
    margin-bottom: 0.6em;
  }
  .post-body :global(h3) {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-weight: 400;
    color: #3b2314;
    margin-top: 1.4em;
    margin-bottom: 0.5em;
  }
  .post-body :global(a) {
    color: #c49a3c;
    text-decoration: underline;
  }
  .post-body :global(a:hover) {
    filter: brightness(1.1);
  }
  .post-body :global(ul) {
    margin: 0 0 1.4em 0;
    padding-left: 1.2em;
    list-style: disc;
  }
  .post-body :global(ol) {
    margin: 0 0 1.4em 0;
    padding-left: 1.2em;
    list-style: decimal;
  }
  .post-body :global(li) {
    font-size: 17px;
    color: #2c2c2c;
    line-height: 1.7;
    margin-bottom: 0.5em;
  }
  .post-body :global(strong) {
    color: #3b2314;
    font-weight: 600;
  }
  .post-body :global(blockquote) {
    border-left: 3px solid #8a9e7b;
    padding-left: 1.2em;
    margin: 1.6em 0;
    font-style: italic;
    color: #3b2314;
  }
</style>
