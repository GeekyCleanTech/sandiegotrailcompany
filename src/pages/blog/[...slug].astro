---
import { getCollection, render } from 'astro:content';
import SiteLayout from '~/layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('post', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmtDate = (d?: Date) =>
  d ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';

const metadata = {
  title: post.data.title,
  description: post.data.excerpt || post.data.title,
};
---

<SiteLayout metadata={metadata}>
  <!-- Header band -->
  <section class="px-6 lg:px-12 pt-32 pb-12 lg:pt-40 lg:pb-14" style="background-color:#3b2314;">
    <div class="max-w-[760px] mx-auto">
      {
        post.data.category && (
          <div class="uppercase tracking-[0.2em] mb-4" style="font-size:11px;color:#8a9e7b;">
            {post.data.category}
          </div>
        )
      }
      <h1
        class="text-white mb-5"
        style="font-family:'Cormorant Garamond',serif;font-size:clamp(34px,5.5vw,56px);font-weight:300;line-height:1.12;"
      >
        {post.data.title}
      </h1>
      <div style="font-size:13px;color:rgba(255,255,255,0.6);letter-spacing:0.05em;">
        {fmtDate(post.data.publishDate)}{post.data.author ? ` · ${post.data.author}` : ''}
      </div>
    </div>
  </section>

  <article class="px-6 lg:px-12 py-14 lg:py-20" style="background-color:#f5f0e8;">
    <div class="max-w-[760px] mx-auto">
      {
        post.data.image && (
          <img
            src={post.data.image}
            alt={post.data.title}
            class="w-full rounded-lg mb-10"
            style="max-height:460px;object-fit:cover;"
            loading="lazy"
            decoding="async"
          />
        )
      }
      <div class="post-body">
        <Content />
      </div>

      <div class="mt-14 pt-8" style="border-top:1px solid rgba(59,35,20,0.12);">
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 hover:gap-3 transition-all"
          style="font-size:13px;color:#c49a3c;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;"
        >
          ← Back to the Journal
        </a>
      </div>
    </div>
  </article>
</SiteLayout>

<style>
  .post-body :global(p) {
    font-size: 17px;
    color: #2c2c2c;
    line-height: 1.85;
    margin-bottom: 1.4em;
  }
  .post-body :global(h2) {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(26px, 3.5vw, 34px);
    font-weight: 400;
    color: #3b2314;
    line-height: 1.2;
    margin-top: 1.8em;
    margin-bottom: 0.6em;
  }
  .post-body :global(h3) {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
    font-weight: 400;
    color: #3b2314;
    margin-top: 1.4em;
    margin-bottom: 0.5em;
  }
  .post-body :global(a) {
    color: #c49a3c;
    text-decoration: underline;
  }
  .post-body :global(a:hover) {
    filter: brightness(1.1);
  }
  .post-body :global(ul) {
    margin: 0 0 1.4em 0;
    padding-left: 1.2em;
    list-style: disc;
  }
  .post-body :global(ol) {
    margin: 0 0 1.4em 0;
    padding-left: 1.2em;
    list-style: decimal;
  }
  .post-body :global(li) {
    font-size: 17px;
    color: #2c2c2c;
    line-height: 1.7;
    margin-bottom: 0.5em;
  }
  .post-body :global(strong) {
    color: #3b2314;
    font-weight: 600;
  }
  .post-body :global(blockquote) {
    border-left: 3px solid #8a9e7b;
    padding-left: 1.2em;
    margin: 1.6em 0;
    font-style: italic;
    color: #3b2314;
  }
</style>
