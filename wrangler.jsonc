{
  // Cloudflare Workers static-assets deploy for sandiegotrailcompany.com.
  // Workers Builds runs `npm run build`, then `npx wrangler deploy`, which
  // uploads ./dist. `_redirects` and `_headers` in ./dist are honored.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandiegotrailcompany",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
